---
import DiagramFigure from './DiagramFigure.astro';
---

<DiagramFigure
  caption="Several frames usually fall between two fixed steps. Each one draws at a blended position. The actor's Transform keeps the value from the last step."
>
  <svg viewBox="0 0 720 300" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>
      Two timelines. The simulation advances in fixed steps, while frames render about three
      times as often, so three frames fall between one pair of steps and each draws at an
      interpolated position.
    </title>

    <defs>
      <marker id="it-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--diagram-stroke)" />
      </marker>
      <marker id="it-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--diagram-accent)" />
      </marker>
    </defs>

    <g stroke="var(--diagram-stroke)" fill="none" stroke-width="1.5" font-size="13" font-family="inherit">
      <rect x="350" y="30" width="160" height="246" rx="8" fill="var(--diagram-fill)" fill-opacity="0.35" stroke="var(--diagram-accent)" stroke-dasharray="5 4" />
      <text x="430" y="20" fill="var(--diagram-accent)" text-anchor="middle" stroke="none" font-size="11">one fixed step &#183; 20 ms</text>

      <text x="8" y="44" fill="var(--diagram-text)" stroke="none" font-size="12">fixedUpdate</text>
      <text x="8" y="60" fill="var(--diagram-muted)" stroke="none" font-size="10">fixed rate &#183; 50 Hz</text>
      <path d="M150 52 L706 52" marker-end="url(#it-arrow)" />
      <g fill="var(--diagram-fill)">
        <circle cx="190" cy="52" r="7" /><circle cx="350" cy="52" r="7" />
        <circle cx="510" cy="52" r="7" /><circle cx="670" cy="52" r="7" />
      </g>
      <text x="342" y="38" fill="var(--diagram-text)" text-anchor="end" stroke="none" font-size="11">step n</text>
      <text x="518" y="38" fill="var(--diagram-text)" text-anchor="start" stroke="none" font-size="11">step n+1</text>

      <text x="8" y="256" fill="var(--diagram-text)" stroke="none" font-size="12">render</text>
      <text x="8" y="272" fill="var(--diagram-muted)" stroke="none" font-size="10">variable rate &#183; 60&#8211;144 Hz</text>
      <path d="M150 264 L706 264" marker-end="url(#it-arrow)" />
      <g fill="var(--diagram-accent)" stroke="var(--diagram-accent)">
        <circle cx="170" cy="264" r="5" /><circle cx="222" cy="264" r="5" />
        <circle cx="268" cy="264" r="5" /><circle cx="325" cy="264" r="5" />
        <circle cx="375" cy="264" r="5" /><circle cx="422" cy="264" r="5" />
        <circle cx="478" cy="264" r="5" /><circle cx="528" cy="264" r="5" />
        <circle cx="580" cy="264" r="5" /><circle cx="625" cy="264" r="5" />
        <circle cx="678" cy="264" r="5" />
      </g>
      <text x="430" y="294" fill="var(--diagram-accent)" text-anchor="middle" stroke="none" font-size="11">each draws at its own blended position</text>

      <rect x="340" y="128" width="180" height="62" rx="8" fill="var(--diagram-fill)" />
      <text x="430" y="152" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="12">interpolated draw position</text>
      <text x="430" y="171" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="10">between step n and step n+1</text>

      <path d="M400 190 L375 254" stroke="var(--diagram-accent)" marker-end="url(#it-arrow-accent)" />
      <path d="M430 190 L422 254" stroke="var(--diagram-accent)" marker-end="url(#it-arrow-accent)" />
      <path d="M460 190 L478 254" stroke="var(--diagram-accent)" marker-end="url(#it-arrow-accent)" />
    </g>
  </svg>
</DiagramFigure>
