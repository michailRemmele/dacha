---
import DiagramFigure from './DiagramFigure.astro';
---

<DiagramFigure
  caption="The configuration says what exists. Your code supplies the classes it names, and the engine matches the two by name."
>
  <svg viewBox="0 0 720 330" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>
      The six configuration keys and the classes passed to the Engine constructor are
      combined by the engine into a running world of scenes, actors, system instances and
      an asset registry.
    </title>

    <defs>
      <marker id="cr-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--diagram-stroke)" stroke="none" />
      </marker>
    </defs>

    <g stroke="var(--diagram-stroke)" fill="none" stroke-width="1.5" font-size="13" font-family="inherit" stroke-linecap="round" stroke-linejoin="round">

      <rect x="8" y="26" width="212" height="210" rx="10" />
      <text x="24" y="48" fill="var(--diagram-accent)" stroke="none" font-size="11">data/data.json</text>
      <rect x="24" y="58" width="180" height="24" rx="5" fill="var(--diagram-fill)" />
      <text x="36" y="75" fill="var(--diagram-text)" stroke="none" font-size="11">scenes</text>
      <rect x="24" y="86" width="180" height="24" rx="5" fill="var(--diagram-fill)" />
      <text x="36" y="103" fill="var(--diagram-text)" stroke="none" font-size="11">startSceneId</text>
      <rect x="24" y="114" width="180" height="24" rx="5" fill="var(--diagram-fill)" />
      <text x="36" y="131" fill="var(--diagram-text)" stroke="none" font-size="11">templates</text>
      <rect x="24" y="142" width="180" height="24" rx="5" fill="var(--diagram-fill)" />
      <text x="36" y="159" fill="var(--diagram-text)" stroke="none" font-size="11">assets</text>
      <rect x="24" y="170" width="180" height="24" rx="5" fill="var(--diagram-fill)" />
      <text x="36" y="187" fill="var(--diagram-text)" stroke="none" font-size="11">systems</text>
      <rect x="24" y="198" width="180" height="24" rx="5" fill="var(--diagram-fill)" />
      <text x="36" y="215" fill="var(--diagram-text)" stroke="none" font-size="11">globalOptions</text>

      <rect x="8" y="252" width="212" height="60" rx="10" stroke-dasharray="5 4" />
      <text x="24" y="274" fill="var(--diagram-accent)" stroke="none" font-size="11">your code</text>
      <text x="24" y="294" fill="var(--diagram-text)" stroke="none" font-size="11">components &#183; systems &#183; assets</text>

      <rect x="268" y="140" width="120" height="56" rx="10" fill="var(--diagram-fill)" />
      <text x="328" y="174" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="13">Engine</text>
      <text x="328" y="212" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="10">matches names to classes</text>

      <path d="M224 132 L264 158" marker-end="url(#cr-arrow)" />
      <path d="M224 282 L264 182" marker-end="url(#cr-arrow)" />
      <path d="M392 168 L432 168" marker-end="url(#cr-arrow)" />

      <rect x="436" y="26" width="276" height="286" rx="10" />
      <text x="452" y="48" fill="var(--diagram-accent)" stroke="none" font-size="11">the running world</text>

      <rect x="452" y="58" width="244" height="30" rx="6" fill="var(--diagram-fill)" />
      <text x="464" y="78" fill="var(--diagram-text)" stroke="none" font-size="12">World</text>

      <rect x="470" y="96" width="226" height="30" rx="6" fill="var(--diagram-fill)" />
      <text x="482" y="116" fill="var(--diagram-text)" stroke="none" font-size="12">Scene &#183; active</text>

      <rect x="488" y="134" width="208" height="30" rx="6" fill="var(--diagram-fill)" />
      <text x="500" y="154" fill="var(--diagram-text)" stroke="none" font-size="12">Actors, some from templates</text>

      <rect x="470" y="180" width="226" height="30" rx="6" fill="none" stroke-dasharray="4 4" />
      <text x="482" y="200" fill="var(--diagram-muted)" stroke="none" font-size="12">other scenes, loaded or not</text>

      <rect x="452" y="228" width="244" height="30" rx="6" fill="var(--diagram-fill)" />
      <text x="464" y="248" fill="var(--diagram-text)" stroke="none" font-size="12">System instances, in list order</text>

      <rect x="452" y="266" width="244" height="30" rx="6" fill="var(--diagram-fill)" />
      <text x="464" y="286" fill="var(--diagram-text)" stroke="none" font-size="12">Asset registry</text>
    </g>
  </svg>
</DiagramFigure>
