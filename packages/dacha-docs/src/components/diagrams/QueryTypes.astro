---
import DiagramFigure from './DiagramFigure.astro';
---

<DiagramFigure
  caption="A raycast and a shape cast move along a direction and report what they hit. An overlap checks one place and reports every collider inside the shape."
>
  <svg viewBox="0 0 720 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>
      Three queries. A raycast goes from an origin until it hits a box, and reports the hit point
      and the normal. A shape cast moves a circle until it touches a box. An overlap finds the
      colliders inside a circle, and ignores a collider outside it.
    </title>

    <defs>
      <marker id="qt-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--diagram-stroke)" stroke="none" />
      </marker>
      <marker id="qt-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--diagram-accent)" stroke="none" />
      </marker>
    </defs>

    <g stroke="var(--diagram-stroke)" fill="none" stroke-width="1.5" font-size="13" font-family="inherit" stroke-linecap="round" stroke-linejoin="round">

      <!-- Raycast -->
      <text x="120" y="28" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="13">Raycast</text>
      <text x="120" y="46" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="10">what a ray hits</text>

      <rect x="160" y="80" width="50" height="120" rx="4" fill="var(--diagram-fill)" />
      <path d="M40 190 L158 131" stroke="var(--diagram-accent)" marker-end="url(#qt-arrow-accent)" />
      <circle cx="40" cy="190" r="4" fill="var(--diagram-stroke)" />
      <text x="40" y="214" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="11">origin</text>
      <text x="84" y="152" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="11">distance</text>

      <circle cx="160" cy="130" r="4" fill="var(--diagram-accent)" stroke="none" />
      <path d="M160 130 L122 130" marker-end="url(#qt-arrow)" />
      <text x="136" y="120" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="11">normal</text>
      <text x="185" y="150" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="11">point</text>

      <!-- Shape cast -->
      <text x="360" y="28" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="13">Shape cast</text>
      <text x="360" y="46" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="10">what a moving shape hits</text>

      <rect x="410" y="90" width="45" height="120" rx="4" fill="var(--diagram-fill)" />
      <path d="M285 132 L392 132" stroke-dasharray="4 3" />
      <path d="M285 168 L392 168" stroke-dasharray="4 3" />
      <circle cx="285" cy="150" r="18" stroke-dasharray="4 3" />
      <circle cx="392" cy="150" r="18" stroke="var(--diagram-accent)" />
      <circle cx="410" cy="150" r="4" fill="var(--diagram-accent)" stroke="none" />
      <text x="285" y="118" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="11">shape</text>
      <path d="M285 200 L390 200" marker-end="url(#qt-arrow)" />
      <text x="338" y="222" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="11">direction</text>

      <!-- Overlap -->
      <text x="600" y="28" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="13">Overlap</text>
      <text x="600" y="46" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="10">what is inside a shape now</text>

      <rect x="520" y="120" width="40" height="40" rx="4" fill="var(--diagram-fill)" stroke="var(--diagram-accent)" />
      <circle cx="640" cy="185" r="18" fill="var(--diagram-fill)" stroke="var(--diagram-accent)" />
      <rect x="665" y="66" width="35" height="30" rx="4" fill="var(--diagram-fill)" />
      <circle cx="600" cy="150" r="55" stroke="var(--diagram-accent)" stroke-dasharray="5 4" />
      <text x="540" y="226" fill="var(--diagram-accent)" text-anchor="middle" stroke="none" font-size="11">found</text>
      <text x="682" y="118" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="11">not found</text>
    </g>
  </svg>
</DiagramFigure>
