---
import DiagramFigure from './DiagramFigure.astro';
---

<DiagramFigure
  caption="The controller compares the normal of each surface with upDirection. A normal within maxSlopeAngle of up is ground, within maxSlopeAngle of down is a ceiling, and anything else is a wall."
>
  <svg viewBox="0 0 720 290" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>
      On the left, a circle of directions. The sector around upDirection, as wide as maxSlopeAngle
      on each side, is ground. The opposite sector is ceiling. The sides are walls. On the right, a
      character stands on a gentle slope whose normal points almost up, next to a wall with a
      sideways normal and under a ceiling with a downward normal.
    </title>

    <defs>
      <marker id="sk-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--diagram-stroke)" stroke="none" />
      </marker>
      <marker id="sk-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--diagram-accent)" stroke="none" />
      </marker>
    </defs>

    <g stroke="var(--diagram-stroke)" fill="none" stroke-width="1.5" font-size="13" font-family="inherit" stroke-linecap="round" stroke-linejoin="round">

      <!-- Direction circle -->
      <circle cx="180" cy="160" r="100" />
      <path d="M180 160 L109.3 89.3 A100 100 0 0 1 250.7 89.3 Z" fill="var(--diagram-accent)" fill-opacity="0.2" stroke="var(--diagram-accent)" />
      <path d="M180 160 L109.3 230.7 A100 100 0 0 0 250.7 230.7 Z" fill="var(--diagram-fill)" />

      <text x="180" y="112" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="13">ground</text>
      <text x="180" y="222" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="13">ceiling</text>
      <text x="112" y="165" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="13">wall</text>
      <text x="248" y="165" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="13">wall</text>

      <path d="M180 160 L180 40" stroke="var(--diagram-accent)" marker-end="url(#sk-arrow-accent)" />
      <text x="190" y="38" fill="var(--diagram-accent)" stroke="none" font-size="12">upDirection</text>

      <path d="M180 124 A36 36 0 0 0 154.5 134.5" stroke="var(--diagram-text)" />
      <path d="M104 128 L150 128" stroke-dasharray="3 3" stroke-width="1" />
      <text x="20" y="132" fill="var(--diagram-muted)" stroke="none" font-size="11">maxSlopeAngle</text>

      <!-- Example -->
      <rect x="400" y="20" width="250" height="20" fill="var(--diagram-fill)" />
      <rect x="650" y="20" width="20" height="240" fill="var(--diagram-fill)" />
      <path d="M400 250 L650 145.8 L650 260 L400 260 Z" fill="var(--diagram-fill)" />

      <rect x="485" y="146" width="30" height="62" rx="15" fill="var(--diagram-accent)" stroke="none" />

      <path d="M580 175 L563 133" stroke="var(--diagram-accent)" marker-end="url(#sk-arrow-accent)" />
      <text x="556" y="124" fill="var(--diagram-accent)" text-anchor="middle" stroke="none" font-size="12">ground</text>

      <path d="M650 100 L610 100" marker-end="url(#sk-arrow)" />
      <text x="640" y="90" fill="var(--diagram-text)" text-anchor="end" stroke="none" font-size="12">wall</text>

      <path d="M520 40 L520 76" marker-end="url(#sk-arrow)" />
      <text x="530" y="68" fill="var(--diagram-text)" stroke="none" font-size="12">ceiling</text>
    </g>
  </svg>
</DiagramFigure>
