---
import DiagramFigure from './DiagramFigure.astro';
---

<DiagramFigure
  caption="Take the offset from the centre of the game element, divide it by zoom, and add the camera position. Here zoom is 2, so the camera sees half of the window size in world units."
>
  <svg viewBox="0 0 720 250" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>
      On the left, the game element in pixels with its origin at the top left, its centre, and a
      point at x, y. On the right, the world with the camera position and the visible area, which is
      half the window size at zoom 2. The offset from the centre, divided by zoom and added to the
      camera position, gives the point in world coordinates.
    </title>

    <defs>
      <marker id="cc-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--diagram-stroke)" stroke="none" />
      </marker>
      <marker id="cc-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--diagram-accent)" stroke="none" />
      </marker>
    </defs>

    <g stroke="var(--diagram-stroke)" fill="none" stroke-width="1.5" font-size="13" font-family="inherit" stroke-linecap="round" stroke-linejoin="round">

      <!-- Screen -->
      <text x="180" y="22" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="13">Game element, pixels</text>
      <rect x="40" y="40" width="280" height="180" rx="4" fill="var(--diagram-fill)" />
      <circle cx="40" cy="40" r="4" fill="var(--diagram-text)" stroke="none" />
      <text x="48" y="58" fill="var(--diagram-muted)" stroke="none" font-size="11">0, 0</text>

      <circle cx="180" cy="130" r="4" fill="var(--diagram-text)" stroke="none" />
      <text x="180" y="152" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="11">windowSize / 2</text>

      <path d="M180 130 L256 82" stroke="var(--diagram-accent)" stroke-dasharray="4 3" marker-end="url(#cc-arrow-accent)" />
      <circle cx="260" cy="80" r="5" fill="var(--diagram-accent)" stroke="none" />
      <text x="268" y="72" fill="var(--diagram-accent)" stroke="none" font-size="12">x, y</text>
      <text x="204" y="96" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="11">offset</text>

      <!-- Conversion -->
      <path d="M336 130 L404 130" marker-end="url(#cc-arrow)" />
      <text x="370" y="116" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="11">&#247; zoom</text>
      <text x="370" y="150" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="11">+ camera</text>

      <!-- World -->
      <text x="560" y="22" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="13">World</text>
      <rect x="420" y="40" width="280" height="180" rx="4" />
      <rect x="490" y="85" width="140" height="90" rx="4" fill="var(--diagram-fill)" stroke-dasharray="4 3" />
      <text x="560" y="194" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="11">visible area at zoom 2</text>

      <circle cx="560" cy="130" r="4" fill="var(--diagram-text)" stroke="none" />
      <text x="560" y="152" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="11">camera position</text>

      <path d="M560 130 L597 107" stroke="var(--diagram-accent)" stroke-dasharray="4 3" marker-end="url(#cc-arrow-accent)" />
      <circle cx="600" cy="105" r="5" fill="var(--diagram-accent)" stroke="none" />
      <text x="600" y="76" fill="var(--diagram-accent)" text-anchor="middle" stroke="none" font-size="12">worldX, worldY</text>
    </g>
  </svg>
</DiagramFigure>
