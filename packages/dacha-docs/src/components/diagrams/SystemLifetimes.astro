---
import DiagramFigure from './DiagramFigure.astro';
---

<DiagramFigure
  caption="One run with two scene changes, and how long each kind of system lives through it."
>
  <svg viewBox="0 0 720 236" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>
      A timeline of one run across three scenes. A world system spans the whole run as a
      single bar; a scene system appears as three separate bars, one per scene.
    </title>

    <defs>
      <marker id="sl-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--diagram-stroke)" stroke="none" />
      </marker>
    </defs>

    <g stroke="var(--diagram-stroke)" fill="none" stroke-width="1.5" font-size="13" font-family="inherit" stroke-linecap="round" stroke-linejoin="round">

      <path d="M150 40 L150 196" stroke="var(--diagram-accent)" stroke-dasharray="4 4" />
      <path d="M370 40 L370 196" stroke="var(--diagram-accent)" stroke-dasharray="4 4" />
      <text x="150" y="30" fill="var(--diagram-accent)" text-anchor="middle" stroke="none" font-size="11">scene change</text>
      <text x="370" y="30" fill="var(--diagram-accent)" text-anchor="middle" stroke="none" font-size="11">scene change</text>

      <text x="8" y="66" fill="var(--diagram-text)" stroke="none" font-size="12">WorldSystem</text>
      <rect x="8" y="76" width="684" height="40" rx="8" fill="var(--diagram-fill)" />
      <text x="350" y="101" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="12">one instance &#183; the whole run</text>

      <text x="8" y="146" fill="var(--diagram-text)" stroke="none" font-size="12">SceneSystem</text>
      <rect x="8" y="156" width="134" height="40" rx="8" fill="var(--diagram-fill)" />
      <text x="75" y="181" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="11">instance</text>
      <rect x="158" y="156" width="204" height="40" rx="8" fill="var(--diagram-fill)" />
      <text x="260" y="181" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="11">a new instance</text>
      <rect x="378" y="156" width="314" height="40" rx="8" fill="var(--diagram-fill)" />
      <text x="535" y="181" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="11">and another</text>

      <path d="M8 222 L700 222" marker-end="url(#sl-arrow)" />
      <text x="75" y="214" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="11">menu</text>
      <text x="260" y="214" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="11">level 1</text>
      <text x="535" y="214" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="11">level 2</text>
    </g>
  </svg>
</DiagramFigure>
