---
import DiagramFigure from './DiagramFigure.astro';
---

<DiagramFigure
  caption="Each phase runs a plain list of systems, in the order the configuration gives. The renderer is one entry in the update list, not a stage of its own."
>
  <svg viewBox="0 0 720 268" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>
      One frame runs every system that implements fixedUpdate, zero or more times, then
      every system that implements update, once. Built-in and project systems sit in the
      same lists.
    </title>

    <defs>
      <marker id="fd-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--diagram-stroke)" stroke="none" />
      </marker>
    </defs>

    <g stroke="var(--diagram-stroke)" fill="none" stroke-width="1.5" font-size="13" font-family="inherit" stroke-linecap="round" stroke-linejoin="round">

      <text x="10" y="20" fill="var(--diagram-accent)" stroke="none" font-size="12">One frame &#183; requestAnimationFrame</text>
      <rect x="8" y="30" width="704" height="228" rx="12" fill="none" stroke="var(--diagram-accent)" stroke-dasharray="5 4" />

      <!-- fixedUpdate phase -->
      <rect x="24" y="48" width="316" height="200" rx="10" fill="none" />
      <text x="40" y="72" fill="var(--diagram-text)" stroke="none" font-size="12">fixedUpdate</text>
      <text x="324" y="72" fill="var(--diagram-muted)" stroke="none" font-size="11" text-anchor="end">0&#8230;n times per frame</text>

      <rect x="40" y="88" width="284" height="24" rx="6" fill="var(--diagram-fill)" />
      <text x="52" y="104" fill="var(--diagram-text)" stroke="none" font-size="12">PhysicsSystem</text>
      <rect x="40" y="118" width="284" height="24" rx="6" fill="var(--diagram-fill)" />
      <text x="52" y="134" fill="var(--diagram-text)" stroke="none" font-size="12">CharacterController</text>
      <rect x="40" y="148" width="284" height="24" rx="6" fill="none" stroke-dasharray="4 4" />
      <text x="52" y="164" fill="var(--diagram-muted)" stroke="none" font-size="12">&#8230; and your systems</text>

      <path d="M348 148 L372 148" marker-end="url(#fd-arrow)" />

      <!-- update phase -->
      <rect x="380" y="48" width="316" height="200" rx="10" fill="none" />
      <text x="396" y="72" fill="var(--diagram-text)" stroke="none" font-size="12">update</text>
      <text x="680" y="72" fill="var(--diagram-muted)" stroke="none" font-size="11" text-anchor="end">once per frame</text>

      <rect x="396" y="88" width="284" height="24" rx="6" fill="var(--diagram-fill)" />
      <text x="408" y="104" fill="var(--diagram-text)" stroke="none" font-size="12">Input systems</text>
      <rect x="396" y="118" width="284" height="24" rx="6" fill="var(--diagram-fill)" />
      <text x="408" y="134" fill="var(--diagram-text)" stroke="none" font-size="12">Animator</text>
      <rect x="396" y="148" width="284" height="24" rx="6" fill="var(--diagram-fill)" />
      <text x="408" y="164" fill="var(--diagram-text)" stroke="none" font-size="12">AudioSystem</text>
      <rect x="396" y="178" width="284" height="24" rx="6" fill="var(--diagram-fill)" />
      <text x="408" y="194" fill="var(--diagram-text)" stroke="none" font-size="12">Renderer</text>
      <rect x="396" y="208" width="284" height="24" rx="6" fill="none" stroke-dasharray="4 4" />
      <text x="408" y="224" fill="var(--diagram-muted)" stroke="none" font-size="12">&#8230; and your systems</text>
    </g>
  </svg>
</DiagramFigure>
