---
import DiagramFigure from './DiagramFigure.astro';
---

<DiagramFigure
  caption="An actor names a behavior with a string. The behavior system looks the name up among the classes the engine was given, and builds one instance for that actor."
>
  <svg viewBox="0 0 720 296" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>
      The Behaviors component on an actor lists a behavior by name together with its
      options. The behavior system matches that name against the behavior classes passed to
      the engine as resources, and constructs one instance of the matching class for the
      actor.
    </title>

    <defs>
      <marker id="bl-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--diagram-stroke)" stroke="none" />
      </marker>
    </defs>

    <g stroke="var(--diagram-stroke)" fill="none" stroke-width="1.5" font-size="13" font-family="inherit" stroke-linecap="round" stroke-linejoin="round">

      <text x="111" y="28" fill="var(--diagram-accent)" text-anchor="middle" stroke="none" font-size="11">your configuration</text>
      <text x="360" y="28" fill="var(--diagram-accent)" text-anchor="middle" stroke="none" font-size="11">the behavior system</text>
      <text x="609" y="28" fill="var(--diagram-accent)" text-anchor="middle" stroke="none" font-size="11">your classes</text>

      <rect x="16" y="44" width="190" height="124" rx="8" />
      <text x="30" y="64" fill="var(--diagram-text)" stroke="none" font-size="12">Actor &#183; Sprout</text>
      <rect x="30" y="76" width="162" height="78" rx="6" fill="var(--diagram-fill)" />
      <text x="42" y="96" fill="var(--diagram-muted)" stroke="none" font-size="10">Behaviors</text>
      <text x="42" y="116" fill="var(--diagram-text)" stroke="none" font-size="11">"GrowPlant"</text>
      <text x="42" y="136" fill="var(--diagram-muted)" stroke="none" font-size="10">secondsPerStage: 4</text>

      <rect x="270" y="76" width="180" height="60" rx="8" fill="var(--diagram-fill)" />
      <text x="360" y="101" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="12">BehaviorSystem</text>
      <text x="360" y="120" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="10">matches on the name</text>

      <rect x="514" y="44" width="190" height="124" rx="8" />
      <text x="528" y="64" fill="var(--diagram-text)" stroke="none" font-size="12">resources</text>
      <rect x="528" y="76" width="162" height="24" rx="5" fill="var(--diagram-fill)" />
      <text x="540" y="93" fill="var(--diagram-accent)" stroke="none" font-size="11">GrowPlant</text>
      <rect x="528" y="104" width="162" height="24" rx="5" fill="var(--diagram-fill)" />
      <text x="540" y="121" fill="var(--diagram-muted)" stroke="none" font-size="11">Patrol</text>
      <rect x="528" y="132" width="162" height="24" rx="5" fill="var(--diagram-fill)" />
      <text x="540" y="149" fill="var(--diagram-muted)" stroke="none" font-size="11">OpenOnApproach</text>

      <path d="M206 106 L266 106" marker-end="url(#bl-arrow)" />
      <path d="M454 106 L510 106" marker-end="url(#bl-arrow)" />
      <text x="482" y="96" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="10">looks up</text>

      <path d="M360 136 L360 216" marker-end="url(#bl-arrow)" />
      <text x="372" y="180" fill="var(--diagram-muted)" stroke="none" font-size="10">builds</text>

      <rect x="230" y="220" width="260" height="60" rx="8" fill="var(--diagram-fill)" />
      <text x="360" y="245" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="12">new GrowPlant(options)</text>
      <text x="360" y="264" fill="var(--diagram-muted)" text-anchor="middle" stroke="none" font-size="10">one instance, running for this actor alone</text>
    </g>
  </svg>
</DiagramFigure>
