---
import DiagramFigure from './DiagramFigure.astro';
---

<DiagramFigure
  caption="Components hold data and never logic. A system selects the actors it acts on by filtering on components, while a behavior is attached to one actor and runs only for it."
>
  <svg viewBox="0 0 720 300" role="img" xmlns="http://www.w3.org/2000/svg">
    <title>
      An actor owns data-only components. A system queries actors by component filter. A
      behavior attaches to a single actor.
    </title>

    <defs>
      <marker id="ecs-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--diagram-stroke)" />
      </marker>
    </defs>

    <g stroke="var(--diagram-stroke)" fill="none" stroke-width="1.5" font-size="13" font-family="inherit">
      <rect x="270" y="24" width="180" height="56" rx="8" fill="var(--diagram-fill)" />
      <text x="360" y="49" fill="var(--diagram-text)" text-anchor="middle" stroke="none">Actor</text>
      <text x="360" y="67" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="11">the entity that owns things</text>

      <text x="360" y="112" fill="var(--diagram-accent)" text-anchor="middle" stroke="none" font-size="11">owns &#8595;</text>

      <rect x="196" y="128" width="108" height="48" rx="6" fill="var(--diagram-fill)" />
      <text x="250" y="149" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="12">Transform</text>
      <text x="250" y="165" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="10">data</text>

      <rect x="312" y="128" width="108" height="48" rx="6" fill="var(--diagram-fill)" />
      <text x="366" y="149" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="12">Sprite</text>
      <text x="366" y="165" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="10">data</text>

      <rect x="428" y="128" width="108" height="48" rx="6" fill="var(--diagram-fill)" />
      <text x="482" y="149" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="12">Collider</text>
      <text x="482" y="165" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="10">data</text>

      <path d="M340 80 L262 128" marker-end="url(#ecs-arrow)" />
      <path d="M360 80 L364 128" marker-end="url(#ecs-arrow)" />
      <path d="M380 80 L470 128" marker-end="url(#ecs-arrow)" />

      <rect x="16" y="196" width="190" height="64" rx="8" fill="var(--diagram-fill)" />
      <text x="111" y="222" fill="var(--diagram-text)" text-anchor="middle" stroke="none">System</text>
      <text x="111" y="240" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="11">logic, per scene or world</text>

      <path d="M111 196 L111 152 L196 152" stroke="var(--diagram-accent)" marker-end="url(#ecs-arrow)" />
      <text x="60" y="144" fill="var(--diagram-accent)" stroke="none" font-size="11">query by</text>
      <text x="60" y="159" fill="var(--diagram-accent)" stroke="none" font-size="11">component filter</text>

      <rect x="514" y="196" width="190" height="64" rx="8" fill="var(--diagram-fill)" />
      <text x="609" y="222" fill="var(--diagram-text)" text-anchor="middle" stroke="none">Behavior</text>
      <text x="609" y="240" fill="var(--diagram-text)" text-anchor="middle" stroke="none" font-size="11">logic, for one actor</text>

      <path d="M609 196 L609 52 L450 52" stroke="var(--diagram-accent)" marker-end="url(#ecs-arrow)" />
      <text x="622" y="150" fill="var(--diagram-accent)" stroke="none" font-size="11">attached to</text>
    </g>
  </svg>
</DiagramFigure>
