---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { MEDIA_BASE_URL } from '../consts';

interface Props {
  /** Basename of the clip in the media bucket, without codec or extension. */
  slug: string;
  poster: ImageMetadata;
  width: number;
  height: number;
  label: string;
  caption: string;
}

const { slug, poster, width, height, label, caption } = Astro.props;

const posterImage = await getImage({ src: poster, format: 'webp', width });
---

<figure class="doc-video">
  <video
    poster={posterImage.src}
    width={width}
    height={height}
    controls
    muted
    loop
    playsinline
    preload="none"
    aria-label={label}
  >
    <source
      src={`${MEDIA_BASE_URL}/video/editor/${slug}.av1.mp4`}
      type='video/mp4; codecs="av01.0.09M.08"'
    />
    <source
      src={`${MEDIA_BASE_URL}/video/editor/${slug}.h264.mp4`}
      type='video/mp4; codecs="avc1.64002A"'
    />
  </video>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .doc-video {
    margin: 1.5rem 0;
  }

  .doc-video video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
  }

  .doc-video figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
