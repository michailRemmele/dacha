---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Imported screenshot of a narrow editor panel. */
  src: ImageMetadata;
  alt: string;
  caption: string;
  /** Displayed width in CSS pixels. Panels are tall, so keep this small. */
  width?: number;
}

const { src, alt, caption, width = 320 } = Astro.props;
---

<figure class="panel-shot" style={`--panel-shot-width: ${width}px`}>
  <Image src={src} alt={alt} width={width * 2} />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .panel-shot {
    margin: 1.5rem 0;
  }
  .panel-shot :global(img) {
    display: block;
    width: 100%;
    max-width: var(--panel-shot-width);
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }
  .panel-shot figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
