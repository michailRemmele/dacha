{
  "name": "dacha-workbench",
  "version": "0.0.38",
  "description": "GUI editor for dacha game engine",
  "exports": {
    ".": {
      "require": "./esm/index.js",
      "import": "./esm/index.js",
      "types": "./esm/index.d.ts"
    },
    "./decorators": {
      "require": "./esm/decorators/index.js",
      "import": "./esm/decorators/index.js",
      "types": "./esm/decorators/index.d.ts"
    }
  },
  "bin": {
    "dacha-workbench": "./bin/index.js"
  },
  "scripts": {
    "start": "env NODE_ENV=development node './bin/index.js' --config 'fixture/dacha-workbench.config.js'",
    "build": "npm run build:clean && npm run build:app && npm run build:esm",
    "build:clean": "rm -rf build && rm -rf esm && rm -rf tsconfig.esm.tsbuildinfo",
    "build:app": "env NODE_ENV=production webpack-cli --config webpack.config.js",
    "build:esm": "tsc -p tsconfig.esm.json && node ./scripts/copy-styles.js",
    "test": "jest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:update": "playwright test --config e2e/playwright.config.ts --update-snapshots",
    "test:e2e:pull-baselines": "node ./scripts/e2e-baselines.js pull",
    "test:e2e:push-baselines": "node ./scripts/e2e-baselines.js push",
    "postinstall": "node ./bin/install.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "bin",
    "build",
    "app-icons",
    "esm",
    "electron",
    "webpack.base.js",
    "webpack.config.js",
    "webpack.extension.config.js",
    "LICENSE",
    "index.js",
    "preload.js",
    "package.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michailRemmele/dacha-workbench.git"
  },
  "author": "Mikhail Remmele",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/michailRemmele/dacha-workbench/issues"
  },
  "homepage": "https://github.com/michailRemmele/dacha-workbench#readme",
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@gravity-ui/icons": "^2.22.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/lodash.isequal": "^4.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "antd": "6.6.2",
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "dacha": "0.19.0-alpha.1",
    "dayjs": "1.11.23",
    "html-webpack-plugin": "5.6.8",
    "i18next": "26.4.1",
    "jest-environment-jsdom": "30.5.1",
    "lodash.isequal": "4.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.13",
    "reflect-metadata": "^0.2.2",
    "style-loader": "4.0.0",
    "terser-webpack-plugin": "5.6.1",
    "ts-loader": "^9.5.2",
    "typescript": "6.0.3",
    "webpack": "5.110.2",
    "webpack-cli": "7.2.3",
    "webpack-dev-middleware": "8.1.1",
    "webpack-virtual-modules": "0.6.2"
  },
  "dependencies": {
    "@electron/packager": "20.3.0",
    "commander": "15.0.0",
    "electron": "44.1.1",
    "express": "5.2.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
