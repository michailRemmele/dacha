{
  "name": "dacha-workbench",
  "version": "0.0.38",
  "description": "GUI editor for dacha game engine",
  "exports": {
    ".": {
      "require": "./esm/index.js",
      "import": "./esm/index.js",
      "types": "./esm/index.d.ts"
    },
    "./decorators": {
      "require": "./esm/decorators/index.js",
      "import": "./esm/decorators/index.js",
      "types": "./esm/decorators/index.d.ts"
    }
  },
  "bin": {
    "dacha-workbench": "./bin/index.js"
  },
  "scripts": {
    "start": "env NODE_ENV=development node './bin/index.js' --config 'fixture/dacha-workbench.config.js'",
    "build": "npm run build:clean && npm run build:app && tsc -p tsconfig.esm.json",
    "build:clean": "rm -rf build && rm -rf esm && rm -rf tsconfig.esm.tsbuildinfo",
    "build:app": "env NODE_ENV=production webpack --config webpack.config.js",
    "test": "jest",
    "postinstall": "node ./bin/install.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "bin",
    "build",
    "app-icons",
    "esm",
    "electron",
    "webpack.base.js",
    "webpack.config.js",
    "webpack.extension.config.js",
    "LICENSE",
    "index.js",
    "preload.js",
    "package.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michailRemmele/dacha-workbench.git"
  },
  "author": "Mikhail Remmele",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/michailRemmele/dacha-workbench/issues"
  },
  "homepage": "https://github.com/michailRemmele/dacha-workbench#readme",
  "devDependencies": {
    "@dnd-kit/core": "6.0.8",
    "@dnd-kit/sortable": "7.0.2",
    "@dnd-kit/utilities": "3.2.1",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@gravity-ui/icons": "^2.21.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@types/lodash.isequal": "^4.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "antd": "5.27.3",
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "11.0.0",
    "css-loader": "6.7.1",
    "dacha": "0.19.0-alpha.1",
    "dayjs": "1.11.18",
    "html-webpack-plugin": "5.5.0",
    "i18next": "21.8.9",
    "jest-environment-jsdom": "30.4.1",
    "lodash.isequal": "4.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "11.17.2",
    "reflect-metadata": "^0.2.2",
    "style-loader": "3.3.1",
    "terser-webpack-plugin": "5.6.1",
    "ts-loader": "^9.5.2",
    "typescript": "6.0.3",
    "webpack": "5.72.0",
    "webpack-cli": "4.9.2",
    "webpack-dev-middleware": "5.3.3",
    "webpack-virtual-modules": "0.6.2"
  },
  "dependencies": {
    "@electron/packager": "20.3.0",
    "commander": "9.3.0",
    "electron": "43.4.0",
    "express": "4.18.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
