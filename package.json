{
  "name": "dacha-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "dacha game engine and its GUI editor",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build:app -w dacha-workbench",
    "clean": "tsc -b --clean && rm -rf packages/dacha-workbench/build packages/dacha-workbench/build-app",
    "pretest": "tsc -b",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "npm run build && npm run test:e2e:pull-baselines -w dacha-workbench && npm run test:e2e -w dacha-workbench",
    "lint": "eslint .",
    "dev": "concurrently -k -n tsc,editor -c blue,green \"tsc -b --watch --preserveWatchOutput\" \"npm start -w dacha-workbench\"",
    "docs:dev": "npm run dev -w dacha-docs",
    "docs:build": "npm run build -w dacha-docs",
    "docs:preview": "npm run preview -w dacha-docs",
    "docs:media:pull": "npm run media:pull -w dacha-docs",
    "docs:media:push": "npm run media:push -w dacha-docs",
    "prepare": "husky",
    "pack:local": "node scripts/pack-local.js",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@typescript-eslint/parser": "8.69.0",
    "concurrently": "^10.0.5",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-node": "0.4.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "^17.12.0",
    "husky": "9.1.7",
    "jest": "30.5.1",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
